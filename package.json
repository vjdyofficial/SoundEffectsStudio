{
  "name": "vjdyfm-sfxstudio",
  "version": "26.11.29",
  "appId": "app.vjdyofficial.andromeda",
  "productName": "VJDY FM Sound Effects Studio",
  "description": "VJDY FM Sound Effects Studio Virtual Soundboard and Media Amplifier",
  "displayName": "VJDY FM Sound Effects Studio",
  "author": "VJDY Official Pictures",
  "license": "Apache-2.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "app.vjdyofficial.andromeda",
    "productName": "VJDY FM Sound Effects Studio",
    "icon": "icons/icon.ico",
    "asar": false,
    "files": [
      "**/*"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "fileAssociations": [
        {
          "ext": "sfxl",
          "name": "SFXStudio Looper Pack",
          "description": "SFXStudio Looper Pack",
          "icon": "icons/fileformat/iconfile_sfxl.ico",
          "role": "Editor"
        },
        {
          "ext": "b64i",
          "name": "SFXStudio Base64 Image String",
          "description": "SFXStudio Base64 Image String",
          "icon": "icons/fileformat/iconfile_b64i.ico",
          "role": "Editor"
        },
        {
          "ext": "bbcx",
          "name": "SFXStudio Telepropmt Document",
          "description": "SFXStudio Teleprompt Document",
          "icon": "icons/fileformat/iconfile_bbcx.ico",
          "role": "Editor"
        },
        {
          "ext": "sfxstudiodat",
          "name": "SFXStudio User Data",
          "description": "SFXStudio User Data",
          "icon": "icons/fileformat/iconfile_sfxstudiodata.ico",
          "role": "Editor"
        },
        {
          "ext": "f32",
          "name": "SFXStudio Float32 Raw Audio",
          "description": "SFXStudio Float32 Raw Audio",
          "icon": "icons/fileformat/iconfile_f32.ico",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VJDY FM Sound Effects Studio",
      "artifactName": "sfxstudio-setup.exe",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@2toad/profanity": "^3.3.0",
    "@derhuerst/ffprobe-static": "^5.3.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "all": "^0.0.0",
    "electron-color-picker": "^0.2.0",
    "ffmpeg-static": "^5.3.0",
    "follow-redirects": "^1.16.3",
    "font-list": "^2.1.0",
    "isexe": "^4.0.0",
    "jsmediatags": "^3.9.7",
    "leaflet": "^1.9.4",
    "music-metadata": "^12.7.0",
    "native-datepicker": "^1.1.1",
    "ps-list": "^9.0.0",
    "ws": "^8.23.0"
  },
  "allowScripts": {
    "ffmpeg-static": true,
    "midi-player-js@2.0.17": true
  }
}
