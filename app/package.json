{
  "name": "vjdyfm-sfxstudio",
  "version": "4.0.0",
  "description": "VJDY FM Sound Effects Studio Virtual Soundboard and Media Amplifier",
  "keywords": [
    "electron",
    "soundboard",
    "audio",
    "sfx"
  ],
  "displayName": "VJDY FM Sound Effects Studio",
  "copyright": "Copyright (c) VJDY Official Pictures",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "app.vjdyofficial.sfxstudio",
    "files": [
      "**/*",
      "!sfx/**",
      "!startBuildInstall.ps1"
    ],
    "extraResources": [],
    "productName": "VJDY FM Sound Effects Studio",
    "artifactName": "sfxstudio-setup.exe",
    "asar": false,
    "win": {
      "fileAssociations": [
        {
          "ext": "subw",
          "name": "SFXStudio Bass Preset",
          "description": "SFXStudio Bass Preset",
          "icon": "./icons/iconfile_subw.ico",
          "role": "Editor"
        },
        {
          "ext": "srs",
          "name": "SFXStudio Surround Sound Preset",
          "description": "SFXStudio Surround Sound Preset",
          "icon": "./icons/iconfile_srs.ico",
          "role": "Editor"
        },
        {
          "ext": "b64i",
          "name": "SFXStudio Base64 Image String",
          "description": "SFXStudio Base64 Image String",
          "icon": "./icons/iconfile_b64i.ico",
          "role": "Editor"
        }
      ],
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^25.1.8"
  },
  "author": "VJDY Official Pictures",
  "license": "MIT",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "electron-color-picker": "^0.2.0",
    "fluent-ffmpeg": "^2.1.3",
    "jsmediatags": "^3.9.7",
    "loudness": "^0.4.2",
    "ps-list": "^9.0.0",
    "winreg": "^1.2.5"
  }
}