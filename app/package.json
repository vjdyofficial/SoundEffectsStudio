{
  "name": "vjdyfm-sfxstudio",
  "version": "26.3.28.0",
  "productName": "VJDY FM Sound Effects Studio",
  "description": "VJDY FM Sound Effects Studio Virtual Soundboard and Media Amplifier",
  "displayName": "VJDY FM Sound Effects Studio",
  "author": "VJDY Official Pictures",
  "license": "Apache-2.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "debug": "startDebug.cmd",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "app.vjdyofficial.andromeda",
    "productName": "VJDY FM Sound Effects Studio",
    "icon": "icons/icon.ico",
    "asar": false,
    "files": [
      "**/*"
    ],
    "win": {
      "icon": "icons/icon.ico",
      "fileAssociations": [
        {
          "ext": "subw",
          "name": "SFXStudio Bass Preset",
          "description": "SFXStudio Bass Preset",
          "icon": "icons/fileformat/iconfile_subw.ico",
          "role": "Editor"
        },
        {
          "ext": "srs",
          "name": "SFXStudio Stereo Enhancer Preset",
          "description": "SFXStudio Stereo Enhancer Preset",
          "icon": "icons/fileformat/iconfile_srs.ico",
          "role": "Editor"
        },
        {
          "ext": "bbcx",
          "name": "BBCode Teleprompt Format",
          "description": "BBCode Teleprompt Format",
          "icon": "icons/fileformat/iconfile_bbcx.ico",
          "role": "Editor"
        },
        {
          "ext": "b64i",
          "name": "SFXStudio Base64 Image String",
          "description": "SFXStudio Base64 Image String",
          "icon": "icons/fileformat/iconfile_b64i.ico",
          "role": "Editor"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "VJDY FM Sound Effects Studio",
      "artifactName": "sfxstudio-setup.exe",
      "runAfterFinish": true
    }
  },
  "devDependencies": {
    "electron": "^39.7.0",
    "electron-builder": "^23.0.6",
    "electron-color-picker": "^0.2.0"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "custom-audio-node": "^0.3.1",
    "electron-color-picker": "^0.2.0",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "follow-redirects": "^1.15.11",
    "font-list": "^2.0.1",
    "jsmediatags": "^3.9.7",
    "leaflet": "^1.9.4",
    "music-metadata": "^11.10.5",
    "ps-list": "^9.0.0"
  }
}
