{
  "name": "vjdyfm-sfxstudio",
  "version": "3.5.5",
  "description": "VJDY FM Sound Effects Studio Virtual Soundboard and Media Amplifier",
  "keywords": [
    "electron",
    "soundboard",
    "audio",
    "sfx"
  ],
  "displayName": "VJDY FM Sound Effects Studio",
  "copyright": "Copyright (c) VJDY Official Pictures",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "app.vjdyofficial.sfxstudio",
    "files": [
      "**/*",
      "!sfx/**"
    ],
    "extraResources": [],
    "productName": "VJDY FM Sound Effects Studio",
    "artifactName": "sfxstudio-setup.exe",
    "asar": false,
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^38.1.2",
    "electron-builder": "^25.1.8"
  },
  "author": "VJDY Official Pictures",
  "license": "MIT",
  "dependencies": {
    "electron-color-picker": "^0.2.0",
    "jsmediatags": "^3.9.7",
    "loudness": "^0.4.2",
    "ps-list": "^9.0.0",
    "soundbank-pitch-shift": "^1.0.3",
    "soundtouchjs": "^0.2.1",
    "winreg": "^1.2.5"
  }
}
